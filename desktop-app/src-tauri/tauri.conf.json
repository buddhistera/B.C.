{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buddhist Era",
  "version": "1.0.0",
  "identifier": "app.vercel.buddhist-era.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Buddhist Era | බුද්ධ වර්ෂය",
        "width": 520,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Buddhist Era",
    "copyright": "Buddhist Era — buddhist-era.vercel.app",
    "category": "Reference",
    "shortDescription": "Buddhist Era — බුද්ධ වර්ෂය",
    "longDescription": "Buddhist Era calendar, Uposatha days, sunrise/noon times and Pali chanting. Works offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
